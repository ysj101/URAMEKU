# GitHub Pages プロジェクトサイト（https://<owner>.github.io/URAMEKU/）向けのベースパス。
# 使い方: cp .env.production.example .env.production && npm run build
# ルート配信（開発・プレビュー）ではこの変数を未設定のままにする（base = "/"）。
VITE_BASE_PATH=/URAMEKU/

# JourneyGap is disabled by default. Enable only after configuring the receiver and notice.
VITE_JOURNEYGAP_ENABLED=false
# VITE_JOURNEYGAP_ENDPOINT=https://YOUR_RECEIVER/v1/traces
