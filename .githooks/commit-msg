#!/bin/sh
set -eu

message=$1
filtered=$(mktemp "${message}.XXXXXX")
trap 'rm -f "$filtered"' 0
trap 'exit 1' HUP INT TERM

awk '
  index(tolower($0), "@gmail.com") {
    printf "gmail guard: removed commit message line %d (matched address redacted).\n", NR > "/dev/stderr"
    next
  }
  { print }
' "$message" > "$filtered"
cat "$filtered" > "$message"

for role in AUTHOR COMMITTER; do
  ident=$(git var "GIT_${role}_IDENT")
  email=$(printf '%s\n' "$ident" | sed 's/.*<//; s/>.*//')
  if printf '%s\n' "$email" | grep -Fiq '@gmail.com'; then
    printf 'gmail guard: commit blocked; %s email contains a forbidden domain. Use a non-Gmail address.\n' "$role" >&2
    exit 1
  fi
done
