{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://urameku.example/schema/case.schema.json",
  "title": "ウラメク case data",
  "description": "data/cases/*.json の構造。参照整合（ID が実在するか、予算で必須資料を全部開けるか等）は src/data/validateCase.ts と scripts/validate_cases.mjs で補う。",
  "type": "object",
  "required": [
    "id",
    "title",
    "bias",
    "difficulty",
    "estimated_time",
    "intro",
    "budget",
    "documents",
    "required_evidence",
    "required_link",
    "link_prompt",
    "analysis_tasks",
    "headline_fragments",
    "correct_fragments",
    "debrief",
    "disclaimer"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^case-[0-9]{2}$"
    },
    "title": {
      "type": "string",
      "minLength": 3,
      "maxLength": 60
    },
    "bias": {
      "type": "string",
      "minLength": 1,
      "maxLength": 60
    },
    "difficulty": {
      "type": "string",
      "enum": [
        "NORMAL",
        "HARD",
        "EXPERT"
      ]
    },
    "estimated_time": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20
    },
    "intro": {
      "type": "string",
      "minLength": 10
    },
    "link_prompt": {
      "type": "string",
      "minLength": 10,
      "maxLength": 120
    },
    "budget": {
      "type": "integer",
      "minimum": 1,
      "maximum": 99
    },
    "documents": {
      "type": "array",
      "minItems": 5,
      "maxItems": 12,
      "items": {
        "$ref": "#/$defs/document"
      }
    },
    "required_evidence": {
      "type": "array",
      "minItems": 0,
      "maxItems": 12,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/documentId"
      }
    },
    "required_link": {
      "type": "array",
      "minItems": 0,
      "maxItems": 12,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/documentId"
      }
    },
    "analysis_tasks": {
      "type": "array",
      "minItems": 0,
      "maxItems": 20,
      "items": {
        "$ref": "#/$defs/analysisTask"
      }
    },
    "headline_fragments": {
      "type": "array",
      "minItems": 0,
      "maxItems": 12,
      "items": {
        "$ref": "#/$defs/headlineFragment"
      }
    },
    "correct_fragments": {
      "type": "array",
      "minItems": 0,
      "maxItems": 12,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/fragmentId"
      }
    },
    "debrief": {
      "$ref": "#/$defs/debrief"
    },
    "disclaimer": {
      "type": "string",
      "minLength": 5
    },
    "schemaVersion": {
      "const": 2
    },
    "v2": {
      "$ref": "#/$defs/v2"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "documentId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,31}$",
      "description": "資料 ID。英小文字始まり、英小文字・数字・アンダースコアのみ、32 文字以内。"
    },
    "taskId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,31}$",
      "description": "検証メモ ID。資料 ID と同じ規則（名前空間は別）。"
    },
    "fragmentId": {
      "type": "string",
      "pattern": "^f[0-9]{1,2}$",
      "description": "見出し断片 ID。f0, f1, ... の形式。"
    },
    "visual": {
      "type": "string",
      "enum": [
        "advert",
        "report",
        "ledger",
        "news",
        "photo",
        "ticket",
        "clipping",
        "label",
        "receipt"
      ]
    },
    "document": {
      "type": "object",
      "required": [
        "id",
        "title",
        "content",
        "cost",
        "visual"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/documentId"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "content": {
          "type": "string",
          "minLength": 1
        },
        "cost": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9
        },
        "visual": {
          "$ref": "#/$defs/visual"
        }
      },
      "additionalProperties": false
    },
    "analysisTask": {
      "type": "object",
      "required": [
        "id",
        "prompt",
        "unit",
        "expected",
        "tolerance"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/taskId"
        },
        "prompt": {
          "type": "string",
          "minLength": 1
        },
        "unit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10
        },
        "expected": {
          "type": "number"
        },
        "tolerance": {
          "type": "number",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "fragmentKind": {
      "type": "string",
      "enum": [
        "correct",
        "overgeneralization",
        "misread-statistic",
        "causal-claim",
        "ignored-counter-evidence",
        "unverifiable",
        "other"
      ],
      "description": "断片の種別（docs/GAME_RULES.md 6 章の誤り型）。correct_fragments に含まれる断片は correct、含まれない断片は correct 以外でなければならない（参照整合で検査）。"
    },
    "headlineFragment": {
      "type": "object",
      "required": [
        "id",
        "text"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/fragmentId"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "kind": {
          "$ref": "#/$defs/fragmentKind"
        },
        "reason": {
          "type": "string",
          "minLength": 5,
          "maxLength": 120,
          "description": "その断片が誤り（または正しい）である理由。1 文。"
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/documentId"
          },
          "description": "reason の根拠となる資料 ID（documents に存在すること）。"
        }
      },
      "additionalProperties": false
    },
    "debrief": {
      "type": "object",
      "required": [
        "explanation",
        "takeaway"
      ],
      "properties": {
        "explanation": {
          "type": "string",
          "minLength": 15
        },
        "takeaway": {
          "type": "string",
          "minLength": 8
        },
        "visualGuide": {
          "type": "object",
          "required": [
            "title",
            "intro",
            "image",
            "imageAlt",
            "conclusion",
            "limit",
            "takeaway"
          ],
          "properties": {
            "title": {
              "type": "string",
              "minLength": 1
            },
            "intro": {
              "type": "string",
              "minLength": 1
            },
            "image": {
              "type": "string",
              "minLength": 1,
              "pattern": "^cases/case-[0-9]{2}/debrief/[a-z0-9-]+\\.png$"
            },
            "imageAlt": {
              "type": "string",
              "minLength": 1
            },
            "conclusion": {
              "type": "string",
              "minLength": 1
            },
            "limit": {
              "type": "string",
              "minLength": 1
            },
            "takeaway": {
              "type": "string",
              "minLength": 1
            },
            "steps": {
              "type": "array",
              "minItems": 2,
              "items": {
                "type": "object",
                "required": [
                  "label",
                  "count",
                  "note",
                  "evidence"
                ],
                "properties": {
                  "label": {
                    "type": "string",
                    "minLength": 1
                  },
                  "count": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "note": {
                    "type": "string",
                    "minLength": 1
                  },
                  "evidence": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                },
                "additionalProperties": false
              }
            },
            "comparisons": {
              "type": "array",
              "minItems": 2,
              "items": {
                "type": "object",
                "required": [
                  "label",
                  "numerator",
                  "denominator",
                  "percent",
                  "evidence"
                ],
                "properties": {
                  "label": {
                    "type": "string",
                    "minLength": 1
                  },
                  "numerator": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "denominator": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "percent": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 100
                  },
                  "evidence": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                },
                "additionalProperties": false
              }
            },
            "panels": {
              "type": "array",
              "minItems": 2,
              "items": {
                "type": "object",
                "required": [
                  "title",
                  "body",
                  "evidence"
                ],
                "properties": {
                  "title": {
                    "type": "string",
                    "minLength": 1
                  },
                  "body": {
                    "type": "string",
                    "minLength": 1
                  },
                  "evidence": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false,
          "if": {
            "required": [
              "panels"
            ]
          },
          "else": {
            "required": [
              "steps",
              "comparisons"
            ]
          }
        }
      },
      "additionalProperties": false
    },
    "v2": {
      "type": "object",
      "required": [
        "revision",
        "modes",
        "decoding",
        "graph",
        "reportPrompt"
      ],
      "properties": {
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "modes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": {
            "enum": [
              "decoding",
              "experiment",
              "decision"
            ]
          },
          "uniqueItems": true
        },
        "decoding": {
          "type": "array",
          "minItems": 0,
          "maxItems": 20,
          "items": {
            "type": "object",
            "required": [
              "id",
              "prompt",
              "options"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/taskId"
              },
              "prompt": {
                "type": "string",
                "minLength": 1,
                "maxLength": 5000
              },
              "options": {
                "type": "array",
                "minItems": 2,
                "maxItems": 20,
                "items": {
                  "type": "object",
                  "required": [
                    "id",
                    "text",
                    "status",
                    "accepted",
                    "reason",
                    "evidence"
                  ],
                  "properties": {
                    "id": {
                      "$ref": "#/$defs/taskId"
                    },
                    "text": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 5000
                    },
                    "status": {
                      "enum": [
                        "supported",
                        "contradicted",
                        "uncertain"
                      ]
                    },
                    "accepted": {
                      "type": "boolean"
                    },
                    "reason": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 5000
                    },
                    "evidence": {
                      "type": "array",
                      "minItems": 1,
                      "maxItems": 100,
                      "items": {
                        "$ref": "#/$defs/documentId"
                      },
                      "uniqueItems": true
                    }
                  },
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": false
          }
        },
        "graph": {
          "type": "object",
          "required": [
            "prompt",
            "paths"
          ],
          "properties": {
            "prompt": {
              "type": "string",
              "minLength": 1,
              "maxLength": 5000
            },
            "paths": {
              "type": "array",
              "minItems": 1,
              "maxItems": 20,
              "items": {
                "type": "array",
                "minItems": 1,
                "maxItems": 20,
                "items": {
                  "type": "object",
                  "required": [
                    "from",
                    "to",
                    "relation"
                  ],
                  "properties": {
                    "from": {
                      "$ref": "#/$defs/documentId"
                    },
                    "to": {
                      "$ref": "#/$defs/documentId"
                    },
                    "relation": {
                      "enum": [
                        "supports",
                        "contradicts",
                        "qualifies",
                        "sequence"
                      ]
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          },
          "additionalProperties": false
        },
        "experiment": {
          "type": "object",
          "required": [
            "id",
            "prompt",
            "conditions",
            "choices",
            "revealDocuments",
            "comparisonPrompt",
            "explanation"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/taskId"
            },
            "prompt": {
              "type": "string",
              "minLength": 1,
              "maxLength": 5000
            },
            "conditions": {
              "type": "array",
              "minItems": 1,
              "maxItems": 10,
              "items": {
                "type": "object",
                "required": [
                  "id",
                  "label",
                  "prompt"
                ],
                "properties": {
                  "id": {
                    "$ref": "#/$defs/taskId"
                  },
                  "label": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 5000
                  },
                  "prompt": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 5000
                  }
                },
                "additionalProperties": false
              }
            },
            "choices": {
              "type": "array",
              "minItems": 2,
              "maxItems": 20,
              "items": {
                "type": "object",
                "required": [
                  "id",
                  "text"
                ],
                "properties": {
                  "id": {
                    "$ref": "#/$defs/taskId"
                  },
                  "text": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 5000
                  }
                },
                "additionalProperties": false
              }
            },
            "revealDocuments": {
              "type": "array",
              "minItems": 1,
              "maxItems": 100,
              "items": {
                "$ref": "#/$defs/documentId"
              },
              "uniqueItems": true
            },
            "comparisonPrompt": {
              "type": "string",
              "minLength": 1,
              "maxLength": 5000
            },
            "explanation": {
              "type": "string",
              "minLength": 1,
              "maxLength": 5000
            }
          },
          "additionalProperties": false
        },
        "decision": {
          "type": "object",
          "required": [
            "prompt",
            "objectives",
            "options",
            "resources",
            "revealDocuments",
            "updatePrompt"
          ],
          "properties": {
            "prompt": {
              "type": "string",
              "minLength": 1,
              "maxLength": 5000
            },
            "objectives": {
              "type": "array",
              "minItems": 2,
              "maxItems": 20,
              "items": {
                "type": "object",
                "required": [
                  "id",
                  "text"
                ],
                "properties": {
                  "id": {
                    "$ref": "#/$defs/taskId"
                  },
                  "text": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 5000
                  }
                },
                "additionalProperties": false
              }
            },
            "options": {
              "type": "array",
              "minItems": 2,
              "maxItems": 20,
              "items": {
                "type": "object",
                "required": [
                  "id",
                  "text",
                  "outcome",
                  "tradeoff",
                  "cost"
                ],
                "properties": {
                  "id": {
                    "$ref": "#/$defs/taskId"
                  },
                  "text": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 5000
                  },
                  "outcome": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 5000
                  },
                  "tradeoff": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 5000
                  },
                  "cost": {
                    "type": "integer",
                    "minimum": 0
                  }
                },
                "additionalProperties": false
              }
            },
            "resources": {
              "type": "integer",
              "minimum": 0
            },
            "revealDocuments": {
              "type": "array",
              "minItems": 1,
              "maxItems": 100,
              "items": {
                "$ref": "#/$defs/documentId"
              },
              "uniqueItems": true
            },
            "updatePrompt": {
              "type": "string",
              "minLength": 1,
              "maxLength": 5000
            }
          },
          "additionalProperties": false
        },
        "reportPrompt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 5000
        },
        "board": {
          "type": "object",
          "required": [
            "title",
            "prompt",
            "excerpts",
            "tasks"
          ],
          "properties": {
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 5000
            },
            "prompt": {
              "type": "string",
              "minLength": 1,
              "maxLength": 5000
            },
            "excerpts": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "id",
                  "documentId",
                  "quote"
                ],
                "properties": {
                  "id": {
                    "$ref": "#/$defs/taskId"
                  },
                  "documentId": {
                    "$ref": "#/$defs/documentId"
                  },
                  "quote": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 5000
                  }
                },
                "additionalProperties": false
              },
              "minItems": 1,
              "maxItems": 100
            },
            "tasks": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "id",
                  "title",
                  "prompt",
                  "parts",
                  "fields",
                  "rules",
                  "explanation"
                ],
                "properties": {
                  "id": {
                    "$ref": "#/$defs/taskId"
                  },
                  "title": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 5000
                  },
                  "prompt": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 5000
                  },
                  "parts": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "text": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 5000
                        },
                        "field": {
                          "$ref": "#/$defs/taskId"
                        }
                      },
                      "additionalProperties": false,
                      "if": {
                        "required": [
                          "text"
                        ]
                      },
                      "then": {
                        "required": [
                          "text"
                        ]
                      },
                      "else": {
                        "required": [
                          "field"
                        ]
                      }
                    },
                    "minItems": 1,
                    "maxItems": 40
                  },
                  "fields": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": [
                        "id",
                        "label",
                        "original",
                        "options"
                      ],
                      "properties": {
                        "id": {
                          "$ref": "#/$defs/taskId"
                        },
                        "label": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 5000
                        },
                        "original": {
                          "$ref": "#/$defs/taskId"
                        },
                        "options": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "required": [
                              "id",
                              "text"
                            ],
                            "properties": {
                              "id": {
                                "$ref": "#/$defs/taskId"
                              },
                              "text": {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 5000
                              }
                            },
                            "additionalProperties": false
                          },
                          "minItems": 2,
                          "maxItems": 20
                        }
                      },
                      "additionalProperties": false
                    },
                    "minItems": 1,
                    "maxItems": 20
                  },
                  "rules": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": [
                        "values",
                        "evidence",
                        "disposition",
                        "explanation"
                      ],
                      "properties": {
                        "values": {
                          "type": "object",
                          "additionalProperties": {
                            "$ref": "#/$defs/taskId"
                          }
                        },
                        "evidence": {
                          "type": "array",
                          "items": {
                            "$ref": "#/$defs/taskId"
                          },
                          "minItems": 1,
                          "maxItems": 100,
                          "uniqueItems": true
                        },
                        "disposition": {
                          "enum": [
                            "keep",
                            "revise",
                            "hold"
                          ]
                        },
                        "explanation": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 5000
                        }
                      },
                      "additionalProperties": false
                    },
                    "minItems": 1,
                    "maxItems": 20
                  },
                  "explanation": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 5000
                  }
                },
                "additionalProperties": false
              },
              "minItems": 1,
              "maxItems": 20
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "if": {
    "required": [
      "schemaVersion"
    ],
    "properties": {
      "schemaVersion": {
        "const": 2
      }
    }
  },
  "then": {
    "required": [
      "v2"
    ]
  },
  "else": {
    "properties": {
      "required_evidence": {
        "minItems": 3,
        "maxItems": 3
      },
      "required_link": {
        "minItems": 2,
        "maxItems": 2
      },
      "analysis_tasks": {
        "minItems": 2,
        "maxItems": 2
      },
      "headline_fragments": {
        "minItems": 8,
        "maxItems": 12
      },
      "correct_fragments": {
        "minItems": 3,
        "maxItems": 3
      }
    }
  }
}
