{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://urameku.example/schema/case.schema.json",
  "title": "ウラメク case data",
  "description": "data/cases/*.json の構造。参照整合（ID が実在するか、予算で必須資料を全部開けるか等）は src/data/validateCase.ts と scripts/validate_cases.mjs で補う。",
  "type": "object",
  "required": [
    "id",
    "title",
    "bias",
    "difficulty",
    "estimated_time",
    "intro",
    "budget",
    "documents",
    "required_evidence",
    "required_link",
    "analysis_tasks",
    "headline_fragments",
    "correct_fragments",
    "debrief",
    "disclaimer"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^case-[0-9]{2}$" },
    "title": { "type": "string", "minLength": 3, "maxLength": 60 },
    "bias": { "type": "string", "minLength": 1, "maxLength": 60 },
    "difficulty": { "type": "string", "enum": ["NORMAL", "HARD", "EXPERT"] },
    "estimated_time": { "type": "string", "minLength": 1, "maxLength": 20 },
    "intro": { "type": "string", "minLength": 10 },
    "budget": { "type": "integer", "minimum": 1, "maximum": 99 },
    "documents": {
      "type": "array",
      "minItems": 5,
      "maxItems": 12,
      "items": { "$ref": "#/$defs/document" }
    },
    "required_evidence": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/documentId" }
    },
    "required_link": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/documentId" }
    },
    "analysis_tasks": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": { "$ref": "#/$defs/analysisTask" }
    },
    "headline_fragments": {
      "type": "array",
      "minItems": 8,
      "maxItems": 12,
      "items": { "$ref": "#/$defs/headlineFragment" }
    },
    "correct_fragments": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/fragmentId" }
    },
    "debrief": { "$ref": "#/$defs/debrief" },
    "disclaimer": { "type": "string", "minLength": 5 }
  },
  "additionalProperties": false,
  "$defs": {
    "documentId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,31}$",
      "description": "資料 ID。英小文字始まり、英小文字・数字・アンダースコアのみ、32 文字以内。"
    },
    "taskId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,31}$",
      "description": "検証メモ ID。資料 ID と同じ規則（名前空間は別）。"
    },
    "fragmentId": {
      "type": "string",
      "pattern": "^f[0-9]{1,2}$",
      "description": "見出し断片 ID。f0, f1, ... の形式。"
    },
    "visual": {
      "type": "string",
      "enum": ["advert", "report", "ledger", "news", "photo", "ticket", "clipping", "label", "receipt"]
    },
    "document": {
      "type": "object",
      "required": ["id", "title", "content", "cost", "visual"],
      "properties": {
        "id": { "$ref": "#/$defs/documentId" },
        "title": { "type": "string", "minLength": 1, "maxLength": 40 },
        "content": { "type": "string", "minLength": 1 },
        "cost": { "type": "integer", "minimum": 0, "maximum": 9 },
        "visual": { "$ref": "#/$defs/visual" }
      },
      "additionalProperties": false
    },
    "analysisTask": {
      "type": "object",
      "required": ["id", "prompt", "unit", "expected", "tolerance"],
      "properties": {
        "id": { "$ref": "#/$defs/taskId" },
        "prompt": { "type": "string", "minLength": 1 },
        "unit": { "type": "string", "minLength": 1, "maxLength": 10 },
        "expected": { "type": "number" },
        "tolerance": { "type": "number", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "headlineFragment": {
      "type": "object",
      "required": ["id", "text"],
      "properties": {
        "id": { "$ref": "#/$defs/fragmentId" },
        "text": { "type": "string", "minLength": 1, "maxLength": 40 }
      },
      "additionalProperties": false
    },
    "debrief": {
      "type": "object",
      "required": ["explanation", "takeaway"],
      "properties": {
        "explanation": { "type": "string", "minLength": 15 },
        "takeaway": { "type": "string", "minLength": 8 }
      },
      "additionalProperties": false
    }
  }
}
