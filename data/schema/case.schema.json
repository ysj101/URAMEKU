{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Paper Backside MVP case data",
  "type": "object",
  "required": ["id","title","bias","difficulty","estimated_time","intro","budget","documents","required_evidence","required_link","analysis_tasks","headline_fragments","correct_fragments","debrief","disclaimer"],
  "properties": {
    "id": {"type":"string","pattern":"^case-[0-9]{2}$"},
    "title": {"type":"string","minLength":3},
    "bias": {"type":"string"},
    "difficulty": {"type":"string","enum":["HARD","EXPERT","NORMAL"]},
    "estimated_time": {"type":"string"},
    "intro": {"type":"string","minLength":10},
    "budget": {"type":"integer","minimum":1},
    "documents": {"type":"array","minItems":5,"items":{"type":"object","required":["id","title","content","cost","visual"],"properties":{"id":{"type":"string"},"title":{"type":"string"},"content":{"type":"string"},"cost":{"type":"integer","minimum":0},"visual":{"enum":["advert","report","ledger","news","photo","ticket","clipping","label","receipt"]}},"additionalProperties":false}},
    "required_evidence": {"type":"array","minItems":3,"items":{"type":"string"}},
    "required_link": {"type":"array","minItems":2,"maxItems":2,"items":{"type":"string"}},
    "analysis_tasks": {"type":"array","minItems":2,"maxItems":2,"items":{"type":"object","required":["id","prompt","unit","expected","tolerance"],"properties":{"id":{"type":"string"},"prompt":{"type":"string"},"unit":{"type":"string"},"expected":{"type":"number"},"tolerance":{"type":"number","minimum":0}},"additionalProperties":false}},
    "headline_fragments": {"type":"array","minItems":8,"items":{"type":"object","required":["id","text"],"properties":{"id":{"type":"string"},"text":{"type":"string"}},"additionalProperties":false}},
    "correct_fragments": {"type":"array","minItems":3,"maxItems":3,"items":{"type":"string"}},
    "debrief": {"type":"object","required":["explanation","takeaway"],"properties":{"explanation":{"type":"string","minLength":15},"takeaway":{"type":"string","minLength":8}},"additionalProperties":false},
    "disclaimer": {"type":"string"}
  },
  "additionalProperties":false
}
